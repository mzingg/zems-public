<?xml version="1.0" encoding="UTF-8" ?>
<project
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.zems.mvn</groupId>
    <artifactId>parent_java</artifactId>
    <version>${revision}</version>
    <relativePath>../../.mvn/parent_java</relativePath>
  </parent>

  <groupId>dev.zems.lib</groupId>
  <artifactId>common</artifactId>

  <name>ZEMS (lib) | Common</name>
  <description>ZEMS Common holds the helpers the ZEMS libraries are built and tested with: JUnit tags that sort tests into contract and journey tests, and a per-thread allocation measurement.</description>

  <properties>
    <!-- Marks this module for the public mirror (zems-public); see the value POM for the mechanism. -->
    <zems.public>true</zems.public>
  </properties>

  <dependencies>
    <!-- Needed only by the dev.zems.lib.common.junit test annotations; optional, so consumers bring their own. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>compile</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>

</project>
