<?xml version="1.0" encoding="UTF-8" ?>
<!--
  PUBLIC root POM for the zems-public mirror. This is an overlay: 80_ops/promote/promote.sh copies it over the
  assembled tree as the public repo's root pom.xml. It mirrors the monorepo root pom.xml but:
    - trims <modules> to only the public modules + their parent chain,
    - drops the with-baseline-modules profile (no baselines are public),
    - keeps the release profile here (the public repo is the only place that deploys to Maven Central),
    - carries a real <revision> (promote stamps the release version into the placeholder below).
  Keep the shared regions (metadata, enforcer, pluginManagement) in step with the monorepo root pom.xml — the promote
  drift guard fails the run if the pinned plugin versions diverge.
-->
<project
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.zems</groupId>
  <artifactId>root</artifactId>
  <packaging>pom</packaging>
  <version>${revision}</version>

  <name>ZEMS (root)</name>
  <description>Aggregator and shared build configuration for ZEMS, the Zero-dependency Extensible Module Suite.</description>
  <url>https://github.com/mzingg/zems-public</url>

  <organization>
    <name>ZEMS</name>
    <url>https://zems.dev</url>
  </organization>

  <!--
    Shared publish metadata. The flattened POM (resolveCiFriendliesOnly) keeps the parent reference
    rather than inlining it, so the parent chain (root, parent_common, parent_java) is published too;
    Maven Central reads licence, scm, and developers by walking that chain. `name` and `description`
    are NOT inherited and must sit on every published artifact directly.
  -->
  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>mzingg</id>
      <name>Markus Zingg</name>
      <email>zingg.engineering@gmail.com</email>
    </developer>
  </developers>

  <!--
    inherit.append.path="false" stops Maven appending the child artifactId to the inherited URLs, so every
    module reports the one repository address instead of a made-up per-module path.
  -->
  <scm
    child.scm.connection.inherit.append.path="false"
    child.scm.developerConnection.inherit.append.path="false"
    child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/mzingg/zems-public.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/mzingg/zems-public.git</developerConnection>
    <url>https://github.com/mzingg/zems-public</url>
  </scm>

  <!--
    Distribution: Maven Central via the central-publishing plugin in the release profile — no
    distributionManagement needed (the plugin uploads to the Central Portal). The interim GitHub
    Packages path (a distributionManagement block + plain maven-deploy-plugin) was retired when the
    Maven 3 migration unblocked Central; see the git history of this file to restore it.
  -->

  <!--
    The released version. Unlike the monorepo (which keeps the ${revision} dev sentinel on main), the public
    mirror carries the real version: 80_ops/promote/promote.sh stamps the release version into the placeholder
    below when it assembles the tree, so the public build/deploy needs no -Drevision and the value matches the
    release/<version> git tag.
  -->
  <properties>
    <revision>0.0.12</revision>
    <!-- Reproducible builds: fixed timestamp for all archive entries. REQUIRED on Maven 3 — without it,
         maven-archiver falls back to the SOURCE_DATE_EPOCH env var, which the nix dev shell sets to
         1980-01-01T00:00:00Z, two seconds below the JDK jar tool's minimum (zip timestamps start at
         1980-01-01T00:00:02Z) — and every modular JAR build fails. Keep in step with the monorepo root POM. -->
    <project.build.outputTimestamp>2026-07-05T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <modules>
    <module>.mvn/parent_common</module>
    <module>.mvn/parent_java</module>
    <module>10_lib/common</module>
    <module>10_lib/value</module>
  </modules>

  <profiles>
    <!--
      Release profile: turns an ordinary build into a publishable one. Activated only at release time
      (`mvn -Prelease …`), so day-to-day and CI verify builds are untouched. The plugins here are inherited
      by every module in the reactor; on `pom` modules (root, parents) the source/javadoc steps no-op and gpg
      just signs the .pom. (Bytecode already targets Java 25 for every build — see maven.compiler.release in
      parent_java — so the release needs no compiler override.)

      The actual upload (central-publishing) only fires on the `deploy` phase.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <!-- Relax doclint's "missing" group (no @param / @return / comment) so trivial documentation gaps
                   do not fail javadoc generation. Real javadoc errors (broken @link, malformed HTML, bad
                   references) are still fatal — better to fail the release loudly than ship a broken/empty
                   javadoc jar that the Central Portal rejects (which is what failOnError=false used to mask). -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <configuration>
              <!-- Non-interactive signing: read the passphrase from MAVEN_GPG_PASSPHRASE and feed it to gpg
                   via a loopback pinentry so it works headless in CI. -->
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!--
            Deploy is central-publishing: it collects the reactor's artifacts (with the flattened POMs — real version
            resolved) into one bundle and uploads it to the Central Portal. The wiring is explicit rather than relying
            on the extension's auto-swap of the deploy phase: unbind the default maven-deploy-plugin execution
            (phase=none — there is no distributionManagement to deploy to anyway) and bind central-publishing:publish
            to deploy ourselves. Deterministic regardless of how extension auto-binding treats profile-declared
            plugins, and it is the wiring the 2026-06 Portal upload already proved.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <executions>
              <execution>
                <id>default-deploy</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!--
                Hands-off publishing: after the bundle uploads and PASSES validation it is published to Maven Central
                with no manual step. waitUntil=published makes the release job block until publishing completes, so a
                green CI run means the version is live (waitMaxTime is 1800s/30min, the plugin minimum — a slower-than-
                that Central run would time the job out even though publishing continues). Maven Central is immutable:
                a published version cannot be unpublished or overwritten. Set autoPublish=false to go back to a manual
                "Publish" review in the Portal.
              -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <!-- One bundle per release for the whole published set (all public modules + the parent
                   chain share one version), so the Portal label is the namespace, not a single lib. -->
              <deploymentName>dev.zems ${revision}</deploymentName>
            </configuration>
            <executions>
              <execution>
                <id>central-publish</id>
                <phase>deploy</phase>
                <goals>
                  <goal>publish</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.3</version>
          <executions>
            <execution>
              <id>enforce-versions</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <requireMavenVersion>
                    <!-- Floor 3.9, excludes a Maven 4 final. The real version control is the nix
                         dev shell (pkgs.maven); this rule only catches a wrong local setup. -->
                    <version>[3.9,4)</version>
                  </requireMavenVersion>
                  <requireJavaVersion>
                    <version>25</version>
                  </requireJavaVersion>
                  <requirePluginVersions>
                    <banLatest>true</banLatest>
                    <banRelease>true</banRelease>
                    <banSnapshots>true</banSnapshots>
                    <phases>clean,deploy,site</phases>
                  </requirePluginVersions>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.23.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.22.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <!--
          CI-friendly versions on Maven 3: the reactor resolves ${revision} while building, but
          install/deploy would otherwise publish the raw POM with the literal `${revision}` string,
          which breaks any later resolution from a repository. flatten rewrites each module's POM to
          .flattened-pom.xml (gitignored) with ${revision} resolved — resolveCiFriendliesOnly touches
          nothing else — and points install/deploy at it. updatePomFile=true is REQUIRED: its default
          is false for `pom` packaging, and the published parent chain (root, parent_common,
          parent_java) is exactly that.
        -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>1.8.0</version>
          <configuration>
            <flattenMode>resolveCiFriendliesOnly</flattenMode>
            <updatePomFile>true</updatePomFile>
          </configuration>
          <executions>
            <execution>
              <id>flatten</id>
              <phase>process-resources</phase>
              <goals>
                <goal>flatten</goal>
              </goals>
            </execution>
            <execution>
              <id>flatten-clean</id>
              <phase>clean</phase>
              <goals>
                <goal>clean</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <!-- Pinned to the latest stable 3.x line: the 4.x beta has known
             ConcurrentModificationException bugs under -T (parallel reactor)
             and Quarkus dev mode forks compilation in a way the 4.x beta
             rejects. Bump to 4.x once a non-beta release is published. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <skipIfEmpty>true</skipIfEmpty>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <!-- Release-only plugins (used by the `release` profile above). Pinned here so the
             enforcer's requirePluginVersions is satisfied at the deploy phase. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.12.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
