<?xml version="1.0" encoding="UTF-8" ?>
<project
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.zems</groupId>
    <artifactId>root</artifactId>
    <version>${revision}</version>
    <relativePath>../..</relativePath>
  </parent>

  <groupId>dev.zems.mvn</groupId>
  <artifactId>parent_common</artifactId>
  <packaging>pom</packaging>

  <name>ZEMS (mvn) | Common Parent Module and Dependencies</name>
  <description>Shared properties and root-directory paths inherited by all ZEMS Maven modules.</description>

  <properties>
    <!-- ${maven.multiModuleProjectDirectory} is set by the mvn launcher (it scans upward for the
         .mvn/ directory at the repo root) and is the Maven 3 stand-in for Maven 4's
         ${project.rootDirectory}. -->
    <ops.dir>${maven.multiModuleProjectDirectory}/80_ops</ops.dir>
    <ops.var.dir>${ops.dir}/var</ops.var.dir>
    <tools.dir>${maven.multiModuleProjectDirectory}/.nix/tools</tools.dir>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <profiles>
    <!-- jdtls (the Eclipse JDT Language Server behind the jdtls-lsp plugin) imports the projects through m2e, which sets
         m2e.version on every Maven request. Its compiler then writes to target-ide/ instead of Maven's target/: when its
         view of a sibling module is broken it writes stub classes, and Maven would trust them as up to date. -->
    <profile>
      <id>ide-output</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <build>
        <directory>${project.basedir}/target-ide</directory>
      </build>
    </profile>
  </profiles>

</project>
